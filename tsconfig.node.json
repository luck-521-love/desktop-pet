{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./out",
    "declaration": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsBuildInfo"
  },
  "include": [
    "src/main/**/*.ts",
    "src/sensors/**/*.ts",
    "src/brain/**/*.ts",
    "src/preload/**/*.ts",
    "electron.vite.config.ts"
  ]
}
