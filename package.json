{
  "name": "desktop-pet",
  "version": "1.0.0",
  "description": "Codex-style desktop pet driven by active application state",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File ./dev.ps1",
    "dev:bash": "unset ELECTRON_RUN_AS_NODE && electron-vite dev",
    "build": "electron-vite build",
    "preview": "powershell -NoProfile -Command \"Remove-Item Env:\\ELECTRON_RUN_AS_NODE -ErrorAction SilentlyContinue; npx electron-vite preview\"",
    "pack": "electron-builder --dir",
    "dist": "electron-vite build && electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "active-win": "^8.2.1",
    "framer-motion": "^12.38.0",
    "openai": "^6.36.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "systeminformation": "^5.31.5"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^35.7.5",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.10"
  }
}
